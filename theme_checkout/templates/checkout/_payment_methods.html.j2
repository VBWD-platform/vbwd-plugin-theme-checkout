{#- PaymentMethodsBlock — the first method auto-selected (usePaymentMethods). -#}
<div class="payment-methods-block card" data-testid="payment-methods-block">
  <h3>{{ _('components.paymentMethods.title') }}</h3>
  {%- if payment.error %}
  <div class="error" data-testid="payment-methods-error">{{ _('components.paymentMethods.error') }}</div>
  {%- elif not payment.methods %}
  <div class="empty">{{ _('components.paymentMethods.noMethods') }}</div>
  {%- else %}
  <div class="methods-list">
    {%- for method in payment.methods %}
    {%- set is_selected = method.code == payment.selected_code %}
    <div class="method-option{% if is_selected %} selected{% endif %}" data-testid="payment-method-{{ method.code }}" data-vbwd-payment-method="{{ method.code }}" data-instructions="{{ method.instructions }}">
      <div class="method-header">
        <input id="method-{{ method.code }}" type="radio" name="payment_method" value="{{ method.code }}"{% if is_selected %} checked{% endif %}>
        <label for="method-{{ method.code }}" class="method-name">{{ method.name }}</label>
      </div>
      {%- if method.description %}
      <p data-testid="payment-method-{{ method.code }}-description" class="method-description">{{ method.description }}</p>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
  {%- endif %}
  <div class="method-instructions" data-testid="payment-method-instructions"{% if not payment.instructions %} hidden{% endif %}>
    <p>{{ payment.instructions or '' }}</p>
  </div>
</div>
